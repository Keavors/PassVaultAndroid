<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_exact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Точная длина" />

            <RadioButton
                android:id="@+id/rb_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Диапазон" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_exact"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   или от " />

            <EditText
                android:id="@+id/et_min"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" до " />

            <EditText
                android:id="@+id/et_max"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_lower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Строчные латинские (a–z)" />

        <CheckBox
            android:id="@+id/cb_upper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Заглавные латинские (A–Z)" />

        <CheckBox
            android:id="@+id/cb_digits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цифры (0–9)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cb_symbols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Спецсимволы:" />

            <EditText
                android:id="@+id/et_symbols"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:typeface="monospace" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_require_each"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Минимум по одному из каждой группы" />

        <CheckBox
            android:id="@+id/cb_no_ambiguous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Исключить похожие символы" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Обязательно включить символы:" />

        <EditText
            android:id="@+id/et_required"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Исключить символы:" />

        <EditText
            android:id="@+id/et_excluded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:typeface="monospace" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Сгенерировать" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tv_bits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <Button
            android:id="@+id/btn_copy_gen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Копировать" />
    </LinearLayout>
</ScrollView>
